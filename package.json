{
  "name": "threadsium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dedicated social network and token discussion terminal for Elysium (chain 99901).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
