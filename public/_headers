/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ws: wss: https://rpc.elysium.kinetiq.xyz https://rpc-live.boxa.club https://rpc.elyscan.live https://rpc.agoradex.app; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/favicon-dark.svg
  Cache-Control: public, max-age=86400

/favicon-light.svg
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Cache-Control: public, max-age=86400

/theme-init.js
  Cache-Control: public, max-age=300, must-revalidate

/widget.js
  Cache-Control: public, max-age=300, must-revalidate
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *
