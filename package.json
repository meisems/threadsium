    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "viem": "2.57.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261109.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
